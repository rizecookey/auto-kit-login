{
    "manifest_version": 3,
    "name": "$name$",
    "description": "$description$",
    "version": "$version$",
    "host_permissions": [
        "*://*.kit.edu/"
    ],
    "action": {
        "default_icon": "kit_cookie.png",
        "default_popup": "popup/popup.html"
    },
    "permissions": [
        "webNavigation",
        "webRequest",
        "cookies",
        "storage",
        "scripting"
    ],
    "web_accessible_resources": [
        {
            "extension_ids": [
                "auto-kit-login@rizecookey.net"
            ],
            "resources": ["authenticator/authenticating.html"]
        }
    ],
    "background": {
        "scripts": [
            "background/background.js"
        ]
    },
    "content_scripts": [
        {
            "matches": ["*://idp.scc.kit.edu/*"],
            "js": ["content/auto_submit.js"]
        }
    ],
    "icons": {
        "822": "kit_cookie.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "auto-kit-login@rizecookey.net"
        },
        "gecko_android": {}
    }
}